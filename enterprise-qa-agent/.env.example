# Spring Boot reads process environment, not this file automatically.
# 填写业务模型 Key 后导入进程环境；此示例文件本身不会被 Spring 自动读取。
DASHSCOPE_API_KEY=
# 选择 milvus、pgvector 或 faiss，默认 Milvus。
VECTOR_BACKEND=milvus
# 本项目 Milvus 宿主端口，独立于原 Demo。
MILVUS_URI=http://localhost:19540
# 公开仓库可留空；私有仓库读取与更高访问额度需要授权 Token。
GITHUB_TOKEN=
# 生成假设性文档做向量召回，假设本身不作为事实证据。
HYDE_ENABLED=true
# 建库时用 Embedding 判断语义边界；切换后需要重新建库。
SEMANTIC_CHUNKING_ENABLED=true
# 限定仓库工具可访问的 owner/repository。
GITHUB_REPOSITORY=codedXX/redis-cache-demo
# Optional independent RAGAS judge
# RAGAS 评审模型独立凭证，仅评测时使用。
EVAL_API_KEY=
# 选择能够返回结构化数据的评审模型。
EVAL_MODEL=qwen-plus