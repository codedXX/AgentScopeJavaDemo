<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.5.11</version><relativePath/></parent>
  <groupId>com.example</groupId><artifactId>sales-agent-demo</artifactId><version>1.0.0</version>
  <name>Sales Agent Demo</name>
  <!-- 统一管理 Java 和主要依赖版本。 -->
  <properties>
    <java.version>21</java.version>
    <agentscope.version>1.0.12</agentscope.version>
    <mcp.version>0.17.0</mcp.version>
    <lucene.version>9.12.3</lucene.version>
    <jackson-bom.version>2.21.1</jackson-bom.version>
    <reactor-bom.version>2025.0.2</reactor-bom.version>
  </properties>
  <!-- Web 接口、Agent、知识检索、数据库和测试需要的依赖。 -->
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>io.agentscope</groupId><artifactId>agentscope</artifactId><version>${agentscope.version}</version></dependency>
    <dependency><groupId>com.alibaba</groupId><artifactId>dashscope-sdk-java</artifactId><version>2.23.1</version></dependency>
    <dependency><groupId>io.milvus</groupId><artifactId>milvus-sdk-java</artifactId><version>2.6.6</version></dependency>
    <!-- 仅使用这里的 DocumentSplitters，不使用 LangChain4j 的 Agent/Memory。 -->
    <dependency><groupId>dev.langchain4j</groupId><artifactId>langchain4j</artifactId><version>1.11.0</version></dependency>
    <dependency><groupId>org.apache.lucene</groupId><artifactId>lucene-core</artifactId><version>${lucene.version}</version></dependency>
    <dependency><groupId>org.apache.lucene</groupId><artifactId>lucene-analysis-smartcn</artifactId><version>${lucene.version}</version></dependency>
    <dependency><groupId>org.apache.lucene</groupId><artifactId>lucene-queryparser</artifactId><version>${lucene.version}</version></dependency>
    <dependency><groupId>io.modelcontextprotocol.sdk</groupId><artifactId>mcp</artifactId><version>${mcp.version}</version></dependency>
    <dependency><groupId>com.baomidou</groupId><artifactId>mybatis-plus-spring-boot3-starter</artifactId><version>3.5.17</version></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
    <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <!-- 普通测试由 Surefire 执行。 -->
  <build><plugins>
    <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><configuration><argLine>-Dfile.encoding=UTF-8</argLine></configuration></plugin>
  </plugins></build>
  <!-- 只有显式启用 live-it 时才跑真实外部服务集成测试。 -->
  <profiles><profile><id>live-it</id><build><plugins><plugin>
    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><version>3.5.4</version>
    <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
  </plugin></plugins></build></profile></profiles>
</project>
